PREFIX oc: <https://w3id.org/ontocal/>
PREFIX oeo: <https://openenergyplatform.org/ontology/oeo/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dct: <http://purl.org/dc/terms/>
# Nodes without supplied correspondence remain visible with unbound claim fields.
SELECT ?component ?assertion ?kind ?target ?scope ?personOrganisationOrSoftware ?recordedRole ?source WHERE {
 ?component a oeo:OEO_00000276 .
 OPTIONAL {
   ?assertion a oc:PhysicalCorrespondenceAssertion ; oc:forComponent ?component ;
       oc:correspondenceKind ?kind ; oc:correspondenceTarget ?target ; oc:correspondenceScope ?scope ;
       dct:source ?source .
   { ?assertion oeo:OEO_00140008 ?personOrganisationOrSoftware .
     BIND("contributor to this record" AS ?recordedRole)
   } UNION {
     ?assertion oc:suppliedBy ?personOrganisationOrSoftware .
     BIND("supplier of this record" AS ?recordedRole)
   }
 }
} ORDER BY ?component
