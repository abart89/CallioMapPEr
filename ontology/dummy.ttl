@prefix bfo:    <http://purl.obolibrary.org/obo/BFO_> .
@prefix ontocal: <https://w3id.org/ontocal/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ------------------------------------------------------------
# CallioMapper dummy ontology
# Source of truth for the dummy_schema.yaml LinkML schema.
#
# This is a placeholder used during pipeline development while
# the real calliope_oeo.ttl mapping is being curated.
#
# Contains a single class: CalliopeThing, subclass of bfo:entity
# (BFO_0000001 — the top-level BFO class for all independent continuants
# and occurrents). Every Calliope entity is typed as a CalliopeThing
# until finer-grained OEO classes are added in the real ontology.
# ------------------------------------------------------------

ontocal:CalliopeThing a owl:Class ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:label "Calliope Thing"@en ;
    rdfs:comment "Placeholder superclass for all Calliope model entities."@en .
