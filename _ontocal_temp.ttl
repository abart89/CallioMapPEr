            owl:onProperty ontocal:value ],
        ontocal:SupplyTechParameter ;
    skos:definition "Upper limit on the installed infrastructure capacity to capture the source." ;
    skos:inScheme ontocal:parameters .

ontocal:SourceCapMin a owl:Class ;
    rdfs:label "SourceCapMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:SupplyTechParameter ;
    skos:definition "Lower limit on the installed infrastructure capacity to capture the source." ;
    skos:inScheme ontocal:parameters .

ontocal:SourceEff a owl:Class ;
