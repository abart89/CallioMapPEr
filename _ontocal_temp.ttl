        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:NodeVariable ;
    skos:definition "Curtailment: virtual sink of carrier flow added to ensure model feasibility per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:master.owl.ttl a owl:Ontology ;
    rdfs:label "ontocal_master" ;
    skos:definition "Master schema for ontocal" .

ontocal:CalliopeDataHorizon a owl:Class ;
    rdfs:label "CalliopeDataHorizon" ;
    rdfs:subClassOf ontocal:OneDimensionalTemporalRegion ;
    skos:definition "A one-dimensional temporal region representing the maximal dataset boundaries defined at the base Calliope model level." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeOptimisationRun a owl:Class ;
    rdfs:label "CalliopeOptimisationRun" ;
    rdfs:subClassOf ontocal:Optimisation ;
    skos:definition "A single execution of the Calliope solver against a fully parametrised model." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeResultDataset a owl:Class ;
    rdfs:label "CalliopeResultDataset" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:has_part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:output_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:has_part ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeVariable ;
            owl:onProperty ontocal:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:output_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeOptimisationRun ;
            owl:onProperty ontocal:output_of ],
        ontocal:DataSet ;
    skos:definition "The complete dataset containing all endogenous output variables generated by a Calliope optimisation process." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeScenario a owl:Class ;
    rdfs:label "CalliopeScenario" ;
    rdfs:subClassOf ontocal:Scenario ;
    skos:definition "A specific set of assumptions and parameters defining one Calliope model configuration." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:DataSet a owl:Class ;
    rdfs:label "DataSet" ;
    skos:definition "IAO class for a data set." ;
    skos:exactMatch IAO:IAO_0000100 ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:EndogenousData a owl:Class ;
    rdfs:label "EndogenousData" ;
    skos:definition "OEO class for endogenous data (data determined within the model)." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00030030> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:EnergySystemModel a owl:Class ;
    rdfs:label "EnergySystemModel" ;
    skos:definition "OEO class for energy system models." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00000339> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:ExogenousData a owl:Class ;
    rdfs:label "ExogenousData" ;
    skos:definition "OEO class for exogenous data (input parameters defined outside the model)." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00030029> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:Optimisation a owl:Class ;
    rdfs:label "Optimisation" ;
    skos:definition "OEO class for the core solver/optimisation process." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00000313> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:OutputData a owl:Class ;
    rdfs:label "OutputData" ;
    rdfs:subClassOf ontocal:EndogenousData ;
    skos:definition "OEO class for output data determined by a model calculation." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00020013> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:Scenario a owl:Class ;
    rdfs:label "Scenario" ;
    skos:definition "OEO class for scenarios." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00000364> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:TransmissionTechVariable a owl:Class ;
    rdfs:label "TransmissionTechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeTransmissionTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechVariable ;
    skos:definition "A model variable scoped to a transmission technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

<https://w3id.org/ontocal/AggregationTypeEnum#average> a owl:Class ;
    rdfs:label "average" ;
    rdfs:subClassOf ontocal:AggregationTypeEnum .

<https://w3id.org/ontocal/AggregationTypeEnum#max> a owl:Class ;
    rdfs:label "max" ;
    rdfs:subClassOf ontocal:AggregationTypeEnum .

<https://w3id.org/ontocal/AggregationTypeEnum#min> a owl:Class ;
    rdfs:label "min" ;
    rdfs:subClassOf ontocal:AggregationTypeEnum .

<https://w3id.org/ontocal/AggregationTypeEnum#sum> a owl:Class ;
    rdfs:label "sum" ;
    rdfs:subClassOf ontocal:AggregationTypeEnum .

ontocal:CalliopeConversionTechnology a owl:Class ;
    rdfs:label "CalliopeConversionTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        ontocal:CalliopeTechnology ;
    skos:definition "A technology that converts between different carriers." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeDemandTechnology a owl:Class ;
    rdfs:label "CalliopeDemandTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_in ],
        ontocal:CalliopeTechnology ;
    skos:definition "A technology that consumes a carrier for an external sink." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeModel a owl:Class ;
    rdfs:label "CalliopeModel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:ModelComponent ;
            owl:onProperty ontocal:has_part ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:has_part ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:has_part ],
        ontocal:EnergySystemModel ;
    skos:definition "The overarching informational representation of a Calliope v0.7 model." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeModelParameter a owl:Class ;
    rdfs:label "CalliopeModelParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:aggregation_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:aggregation_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:AggregationTypeEnum ;
            owl:onProperty ontocal:aggregation_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:source_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:source_reference ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeScenario ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:OneDimensionalTemporalRegion ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:source_reference ],
        ontocal:ExogenousData ;
    skos:definition "An input parameter supplied to a Calliope model from outside the optimisation (e.g. costs, capacities, time series)." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeStorageTechnology a owl:Class ;
    rdfs:label "CalliopeStorageTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_out ],
        ontocal:CalliopeTechnology ;
    skos:definition "A technology that stores a carrier." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeSupplyTechnology a owl:Class ;
    rdfs:label "CalliopeSupplyTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_out ],
        ontocal:CalliopeTechnology ;
    skos:definition "A technology that draws from a source to produce a carrier." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeTransmissionTechnology a owl:Class ;
    rdfs:label "CalliopeTransmissionTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:link_to ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeNetworkNode ;
            owl:onProperty ontocal:link_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:link_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:link_from ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:carrier_out ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:link_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeNetworkNode ;
            owl:onProperty ontocal:link_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:carrier_out ],
        ontocal:CalliopeTechnology ;
    skos:definition "A technology that transmits a carrier between nodes." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:NodeVariable a owl:Class ;
    rdfs:label "NodeVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeNetworkNode ;
            owl:onProperty ontocal:is_about ],
        ontocal:CalliopeVariable ;
    skos:definition "A model variable scoped to a specific network node (e.g. node-level cost summaries)." ;
    skos:inScheme <https://w3id.org/ontocal> .

<https://w3id.org/ontocal/SinkUnitEnum#absolute> a owl:Class ;
    rdfs:label "absolute" ;
    rdfs:subClassOf ontocal:SinkUnitEnum .

<https://w3id.org/ontocal/SinkUnitEnum#per_area> a owl:Class ;
    rdfs:label "per_area" ;
    rdfs:subClassOf ontocal:SinkUnitEnum .

<https://w3id.org/ontocal/SinkUnitEnum#per_cap> a owl:Class ;
    rdfs:label "per_cap" ;
    rdfs:subClassOf ontocal:SinkUnitEnum .

<https://w3id.org/ontocal/SourceUnitEnum#absolute> a owl:Class ;
    rdfs:label "absolute" ;
    rdfs:subClassOf ontocal:SourceUnitEnum .

<https://w3id.org/ontocal/SourceUnitEnum#per_area> a owl:Class ;
    rdfs:label "per_area" ;
    rdfs:subClassOf ontocal:SourceUnitEnum .

<https://w3id.org/ontocal/SourceUnitEnum#per_cap> a owl:Class ;
    rdfs:label "per_cap" ;
    rdfs:subClassOf ontocal:SourceUnitEnum .

ontocal:SystemVariable a owl:Class ;
    rdfs:label "SystemVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeModel ;
            owl:onProperty ontocal:is_about ],
        ontocal:CalliopeVariable ;
    skos:definition "A model variable representing a system-wide aggregate quantity (e.g. total system cost, total emissions)." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:has_assigned_technology a owl:ObjectProperty ;
    rdfs:label "has_assigned_technology" ;
    skos:definition "Technologies located at this node. Covers Supply, Demand, Storage, and Conversion. Transmission technologies are excluded — their node assignment is handled via link_from/link_to." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:SupplyTechVariable a owl:Class ;
    rdfs:label "SupplyTechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeSupplyTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechVariable ;
    skos:definition "A model variable scoped to a supply technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:aggregation_type a owl:ObjectProperty ;
    rdfs:label "aggregation_type" ;
    rdfs:range ontocal:AggregationTypeEnum ;
    skos:definition "Specifies the statistical aggregation method used for a parameter representing a macro-summary." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:latitude a owl:DatatypeProperty ;
    rdfs:label "latitude" ;
    skos:definition "WGS84 latitude of the node in decimal degrees." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:link_from a owl:ObjectProperty ;
    rdfs:label "link_from" ;
    skos:definition "The node from which a transmission technology originates." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:link_to a owl:ObjectProperty ;
    rdfs:label "link_to" ;
    skos:definition "The node to which a transmission technology connects." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:longitude a owl:DatatypeProperty ;
    rdfs:label "longitude" ;
    skos:definition "WGS84 longitude of the node in decimal degrees." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:output_of a owl:ObjectProperty ;
    rdfs:label "output_of" ;
    skos:definition "The BFO/OBO standard relation for inverse of has output. Links a continuant (such as output data) to the occurrent process that generated it." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:source_reference a owl:DatatypeProperty ;
    rdfs:label "source_reference" ;
    rdfs:range xsd:string ;
    skos:definition "Provenance string identifying the origin of the parameter value (e.g. 'User CSV Upload', 'base_config.yaml')." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:temporal_part_of a owl:ObjectProperty ;
    rdfs:label "temporal_part_of" ;
    skos:definition "A mereological relation linking a temporal proper part to its temporal whole." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeVariable a owl:Class ;
    rdfs:label "CalliopeVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ontocal:OneDimensionalTemporalRegion ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeNetworkNode ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeEnergyCarrier ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( ontocal:ModelComponent ontocal:CalliopeModel ) ] ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeResultDataset ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:part_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:OutputData ;
    skos:definition "An output variable calculated by the Calliope solver during optimization." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:DemandTechParameter a owl:Class ;
    rdfs:label "DemandTechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeDemandTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechParameter ;
    skos:definition "A model parameter scoped to a demand technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:SinkUnitEnum a owl:Class ;
    owl:unionOf ( <https://w3id.org/ontocal/SinkUnitEnum#absolute> <https://w3id.org/ontocal/SinkUnitEnum#per_area> <https://w3id.org/ontocal/SinkUnitEnum#per_cap> ) ;
    linkml:permissible_values <https://w3id.org/ontocal/SinkUnitEnum#absolute>,
        <https://w3id.org/ontocal/SinkUnitEnum#per_area>,
        <https://w3id.org/ontocal/SinkUnitEnum#per_cap> .

ontocal:SourceUnitEnum a owl:Class ;
    owl:unionOf ( <https://w3id.org/ontocal/SourceUnitEnum#absolute> <https://w3id.org/ontocal/SourceUnitEnum#per_area> <https://w3id.org/ontocal/SourceUnitEnum#per_cap> ) ;
    linkml:permissible_values <https://w3id.org/ontocal/SourceUnitEnum#absolute>,
        <https://w3id.org/ontocal/SourceUnitEnum#per_area>,
        <https://w3id.org/ontocal/SourceUnitEnum#per_cap> .

ontocal:ModelComponent a owl:Class ;
    rdfs:label "ModelComponent" ;
    skos:definition "OEO class for model building blocks." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00000340> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:AggregationTypeEnum a owl:Class ;
    owl:unionOf ( <https://w3id.org/ontocal/AggregationTypeEnum#sum> <https://w3id.org/ontocal/AggregationTypeEnum#average> <https://w3id.org/ontocal/AggregationTypeEnum#max> <https://w3id.org/ontocal/AggregationTypeEnum#min> ) ;
    linkml:permissible_values <https://w3id.org/ontocal/AggregationTypeEnum#average>,
        <https://w3id.org/ontocal/AggregationTypeEnum#max>,
        <https://w3id.org/ontocal/AggregationTypeEnum#min>,
        <https://w3id.org/ontocal/AggregationTypeEnum#sum> .

ontocal:CalliopeNetworkNode a owl:Class ;
    rdfs:label "CalliopeNetworkNode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:longitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:longitude ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:latitude ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:latitude ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:has_assigned_technology ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeTechnology ;
            owl:onProperty ontocal:has_assigned_technology ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:longitude ],
        ontocal:ModelComponent ;
    skos:definition "A spatial node in Calliope." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:OneDimensionalTemporalRegion a owl:Class ;
    rdfs:label "OneDimensionalTemporalRegion" ;
    skos:definition "BFO stub: a one-dimensional temporal region. Parent of all temporal classes in this schema." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:StorageTechVariable a owl:Class ;
    rdfs:label "StorageTechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeStorageTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechVariable ;
    skos:definition "A model variable scoped to a storage technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:TransmissionTechParameter a owl:Class ;
    rdfs:label "TransmissionTechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeTransmissionTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechParameter ;
    skos:definition "A model parameter scoped to a transmission technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:has_part a owl:ObjectProperty ;
    rdfs:label "has_part" ;
    skos:definition "Links a whole to its parts." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:part_of a owl:ObjectProperty ;
    rdfs:label "part_of" ;
    skos:definition "Links a part to its whole." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeTechnology a owl:Class ;
    rdfs:label "CalliopeTechnology" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:name ],
        ontocal:ModelComponent ;
    skos:definition "Base class for Calliope technologies." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:StorageTechParameter a owl:Class ;
    rdfs:label "StorageTechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeStorageTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechParameter ;
    skos:definition "A model parameter scoped to a storage technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:SupplyTechParameter a owl:Class ;
    rdfs:label "SupplyTechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeSupplyTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechParameter ;
    skos:definition "A model parameter scoped to a supply technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CalliopeEnergyCarrier a owl:Class ;
    rdfs:label "CalliopeEnergyCarrier" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ontocal:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:name ],
        ontocal:ModelComponent ;
    skos:definition "An energy carrier that can be used by technologies." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:carrier_in a owl:ObjectProperty ;
    rdfs:label "carrier_in" ;
    skos:definition "The energy carrier consumed as input by a technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:carrier_out a owl:ObjectProperty ;
    rdfs:label "carrier_out" ;
    skos:definition "The energy carrier produced as output by a technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:name a owl:DatatypeProperty .

ontocal:for_carrier a owl:ObjectProperty ;
    rdfs:label "for_carrier" ;
    rdfs:range ontocal:CalliopeEnergyCarrier ;
    skos:definition "The energy carrier this variable is indexed by. Used for carrier-scoped and balancing variables." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:TechParameter a owl:Class ;
    rdfs:label "TechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:CalliopeModelParameter ;
    skos:definition "A model parameter that applies to a specific technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:TechVariable a owl:Class ;
    rdfs:label "TechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeTechnology ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        ontocal:CalliopeVariable ;
    skos:definition "A model variable scoped to a specific technology (e.g. flow_cap, carrier_prod)." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:range xsd:string ;
    skos:definition "Unit of measure for the parameter value (e.g. 'fraction', 'year', 'kW'). Optional metadata hook — not semantically validated beyond equals_string constraints on specific parameter classes." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:applies_to_time a owl:ObjectProperty ;
    rdfs:label "applies_to_time" ;
    rdfs:range ontocal:OneDimensionalTemporalRegion ;
    rdfs:subPropertyOf ontocal:is_about ;
    skos:definition "Links an Information Content Entity to the temporal region it describes. Accepts granular timesteps or macro horizons." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:is_about a owl:ObjectProperty ;
    rdfs:label "is_about" ;
    skos:definition "Relates an information artifact to the entity it is about." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:at_node a owl:ObjectProperty ;
    rdfs:label "at_node" ;
    rdfs:range ontocal:CalliopeNetworkNode ;
    skos:definition "The network node at which a variable is localised. Optional at the base level; required by most tech-scoped variable classes." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:value a owl:DatatypeProperty,
        owl:ObjectProperty .


