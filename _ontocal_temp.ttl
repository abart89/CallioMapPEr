        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechVariable ;
    skos:definition "Maximum reservoir capacity for storing a carrier at a node." ;
    skos:inScheme ontocal:variables .

ontocal:StorageCapMax a owl:Class ;
    rdfs:label "StorageCapMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
