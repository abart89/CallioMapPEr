@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ontocal: <https://w3id.org/ontocal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ontocal:AreaUse a owl:Class ;
    rdfs:label "AreaUse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Physical footprint utilised directly or indirectly by a technology at a node." ;
    skos:inScheme ontocal:variables .

ontocal:AreaUseMax a owl:Class ;
    rdfs:label "AreaUseMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Upper spatial limit for land or area utilised by the technology." ;
    skos:inScheme ontocal:parameters .

ontocal:AreaUseMin a owl:Class ;
    rdfs:label "AreaUseMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Lower spatial limit for land or area utilised by the technology." ;
    skos:inScheme ontocal:parameters .

ontocal:AreaUsePerFlowCap a owl:Class ;
    rdfs:label "AreaUsePerFlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Fixed ratio of required physical area to installed flow capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:AsyncFlowSwitch a owl:Class ;
    rdfs:label "AsyncFlowSwitch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Binary switch forcing asynchronous outflow/consumption to prevent simultaneous production and consumption." ;
    skos:inScheme ontocal:variables .

ontocal:AvailableFlowCap a owl:Class ;
    rdfs:label "AvailableFlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Flow capacity active when a technology unit is online; zero when offline (integer dispatch)." ;
    skos:inScheme ontocal:variables .

ontocal:CalliopeExecutionHorizon a owl:Class ;
    rdfs:label "CalliopeExecutionHorizon" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:temporal_part_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:temporal_part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeDataHorizon ;
            owl:onProperty ontocal:temporal_part_of ],
        ontocal:OneDimensionalTemporalRegion ;
    skos:definition "A one-dimensional temporal region representing the specific sliced subset simulated by a Calliope scenario." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/BFO_0000038> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:CapacityFactor a owl:Class ;
    rdfs:label "CapacityFactor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Computed fraction of operational production relative to installed capacity per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:ConversionTechParameter a owl:Class ;
    rdfs:label "ConversionTechParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeConversionTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechParameter ;
    skos:definition "A model parameter scoped to a conversion technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:ConversionTechVariable a owl:Class ;
    rdfs:label "ConversionTechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeConversionTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechVariable ;
    skos:definition "A model variable scoped to a conversion technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:Cost a owl:Class ;
    rdfs:label "Cost" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Total annualised cost of a technology at a node, summing all investment and operation components." ;
    skos:inScheme ontocal:variables .

ontocal:CostFlowCap a owl:Class ;
    rdfs:label "CostFlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Capital investment cost per unit of installed flow capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:CostFlowCapPerDistance a owl:Class ;
    rdfs:label "CostFlowCapPerDistance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Investment cost per unit of installed flow capacity and per unit of distance." ;
    skos:inScheme ontocal:parameters .

ontocal:CostFlowIn a owl:Class ;
    rdfs:label "CostFlowIn" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Variable operational cost per unit of carrier inflow per timestep." ;
    skos:inScheme ontocal:parameters .

ontocal:CostFlowOut a owl:Class ;
    rdfs:label "CostFlowOut" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Variable operational cost per unit of carrier outflow per timestep." ;
    skos:inScheme ontocal:parameters .

ontocal:CostInterestRate a owl:Class ;
    rdfs:label "CostInterestRate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "fraction" ] ) ] ;
            owl:onProperty ontocal:unit ],
        ontocal:TechParameter ;
    skos:definition "Interest rate applied to compute levelised costs and depreciation." ;
    skos:inScheme ontocal:parameters .

ontocal:CostInvestmentAnnualised a owl:Class ;
    rdfs:label "CostInvestmentAnnualised" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Equivalent annual investment cost discounted via depreciation and interest rates." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentAreaUse a owl:Class ;
    rdfs:label "CostInvestmentAreaUse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Capital investment cost attributable to land or area use." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentFlowCap a owl:Class ;
    rdfs:label "CostInvestmentFlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Capital investment cost attributable to installed flow capacity." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentPurchase a owl:Class ;
    rdfs:label "CostInvestmentPurchase" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Discrete capital cost for purchasing integer technology units." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentSourceCap a owl:Class ;
    rdfs:label "CostInvestmentSourceCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:SupplyTechVariable ;
    skos:definition "Capital investment cost attributable to installed source capture capacity." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentStorageCap a owl:Class ;
    rdfs:label "CostInvestmentStorageCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechVariable ;
    skos:definition "Capital investment cost attributable to installed storage capacity." ;
    skos:inScheme ontocal:variables .

ontocal:CostInvestmentTotal a owl:Class ;
    rdfs:label "CostInvestmentTotal" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Total upfront investment cost summing all capacity-related cost components." ;
    skos:inScheme ontocal:variables .

ontocal:CostOmAnnual a owl:Class ;
    rdfs:label "CostOmAnnual" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Fixed annual operation and maintenance cost per unit of installed capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:CostOperationFixed a owl:Class ;
    rdfs:label "CostOperationFixed" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Fixed annual operation and maintenance cost calculated relative to installed capacity." ;
    skos:inScheme ontocal:variables .

ontocal:CostOperationVariable a owl:Class ;
    rdfs:label "CostOperationVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Variable operating costs (flow in, flow out, export) calculated per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:CostPurchasePerDistance a owl:Class ;
    rdfs:label "CostPurchasePerDistance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Discrete investment cost per unit of distance, used in integer programming formulations." ;
    skos:inScheme ontocal:parameters .

ontocal:CostSourceCap a owl:Class ;
    rdfs:label "CostSourceCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:SupplyTechParameter ;
    skos:definition "Capital investment cost per unit of installed source capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:CostStorageCap a owl:Class ;
    rdfs:label "CostStorageCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Capital investment cost per unit of total storage capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:CyclicStorage a owl:Class ;
    rdfs:label "CyclicStorage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Boolean linking storage level at the final timestep back to the first, enabling continuous yearly operation." ;
    skos:inScheme ontocal:parameters .

ontocal:DemandTechVariable a owl:Class ;
    rdfs:label "DemandTechVariable" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeDemandTechnology ;
            owl:onProperty ontocal:is_about ],
        ontocal:TechVariable ;
    skos:definition "A model variable scoped to a demand technology." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:Distance a owl:Class ;
    rdfs:label "Distance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Physical span of the transmission link. Calliope can compute this automatically if both nodes have coordinates." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCap a owl:Class ;
    rdfs:label "FlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Nominal/nameplate flow capacity of the technology at a node. Core investment decision variable." ;
    skos:inScheme ontocal:variables .

ontocal:FlowCapMax a owl:Class ;
    rdfs:label "FlowCapMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Absolute upper bound on the rated flow capacity of the technology." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCapMaxSystemwide a owl:Class ;
    rdfs:label "FlowCapMaxSystemwide" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Aggregate upper capacity limit across all nodes where the technology exists." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCapMin a owl:Class ;
    rdfs:label "FlowCapMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Absolute lower bound on the rated flow capacity of the technology." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCapMinSystemwide a owl:Class ;
    rdfs:label "FlowCapMinSystemwide" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Aggregate lower capacity limit across all nodes where the technology exists." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCapPerStorageCapMax a owl:Class ;
    rdfs:label "FlowCapPerStorageCapMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Maximum ratio of charge/discharge flow rate to total reservoir volume." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowCapPerStorageCapMin a owl:Class ;
    rdfs:label "FlowCapPerStorageCapMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Minimum ratio of charge/discharge flow rate to total reservoir volume." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowExport a owl:Class ;
    rdfs:label "FlowExport" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Carrier flow exported outside system boundaries per timestep (export-enabled technologies)." ;
    skos:inScheme ontocal:variables .

ontocal:FlowIn a owl:Class ;
    rdfs:label "FlowIn" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        ontocal:TechVariable ;
    skos:definition "Carrier inflow consumed by a technology per timestep (demand, conversion, storage, transmission)." ;
    skos:inScheme ontocal:variables .

ontocal:FlowInEff a owl:Class ;
    rdfs:label "FlowInEff" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "fraction" ] ) ] ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Primary conversion efficiency from inflow carrier to sink (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowInEffPerDistance a owl:Class ;
    rdfs:label "FlowInEffPerDistance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Efficiency decay applied exponentially per unit of distance to the inflow." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowInIncEff a owl:Class ;
    rdfs:label "FlowInIncEff" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Carrier inflow after accounting for flow_in_eff and distance-based losses per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:FlowOut a owl:Class ;
    rdfs:label "FlowOut" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Carrier outflow produced by a technology per timestep (supply, conversion, storage, transmission)." ;
    skos:inScheme ontocal:variables .

ontocal:FlowOutEff a owl:Class ;
    rdfs:label "FlowOutEff" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "fraction" ] ) ] ;
            owl:onProperty ontocal:unit ],
        ontocal:TechParameter ;
    skos:definition "Primary conversion efficiency from source to outflow carrier (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowOutEffPerDistance a owl:Class ;
    rdfs:label "FlowOutEffPerDistance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Efficiency decay applied exponentially per unit of distance to the outflow." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowOutIncEff a owl:Class ;
    rdfs:label "FlowOutIncEff" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        ontocal:TechVariable ;
    skos:definition "Carrier outflow after accounting for efficiency and parasitic losses per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:FlowOutMinRelative a owl:Class ;
    rdfs:label "FlowOutMinRelative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "fraction" ] ) ] ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        ontocal:TechParameter ;
    skos:definition "Fractional minimum operating level as a share of rated capacity (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowOutParasiticEff a owl:Class ;
    rdfs:label "FlowOutParasiticEff" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "fraction" ] ) ] ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        ontocal:TechParameter ;
    skos:definition "Additional efficiency loss as flow is transferred from the plant to the carrier (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:FlowRamping a owl:Class ;
    rdfs:label "FlowRamping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Maximum rate of change in outflow or inflow between consecutive timesteps." ;
    skos:inScheme ontocal:parameters .

ontocal:IncludeStorage a owl:Class ;
    rdfs:label "IncludeStorage" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Boolean switch that activates intertemporal storage buffers for non-storage technologies." ;
    skos:inScheme ontocal:parameters .

ontocal:Lifetime a owl:Class ;
    rdfs:label "Lifetime" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "year" ] ) ] ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechParameter ;
    skos:definition "Operational lifespan in years, used for annualised investment cost calculations." ;
    skos:inScheme ontocal:parameters .

ontocal:LinkFlowCap a owl:Class ;
    rdfs:label "LinkFlowCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:TransmissionTechVariable ;
    skos:definition "Nominal flow capacity of a transmission link. Investment decision variable for transmission." ;
    skos:inScheme ontocal:variables .

ontocal:NodeParameter a owl:Class ;
    rdfs:label "NodeParameter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom ontocal:CalliopeNetworkNode ;
            owl:onProperty ontocal:is_about ],
        ontocal:CalliopeModelParameter ;
    skos:definition "A model parameter that applies to a specific node." ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:OneWay a owl:Class ;
    rdfs:label "OneWay" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TransmissionTechParameter ;
    skos:definition "Boolean restriction forcing the link to operate exclusively from link_from to link_to." ;
    skos:inScheme ontocal:parameters .

ontocal:OperatingUnits a owl:Class ;
    rdfs:label "OperatingUnits" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        ontocal:TechVariable ;
    skos:definition "Integer number of technology units actively operating in each timestep (integer dispatch)." ;
    skos:inScheme ontocal:variables .

ontocal:PurchasedUnits a owl:Class ;
    rdfs:label "PurchasedUnits" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:TechVariable ;
    skos:definition "Integer number of fixed-capacity technology units purchased (integer capacity planning)." ;
    skos:inScheme ontocal:variables .

ontocal:SinkUnit a owl:Class ;
    rdfs:label "SinkUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ontocal:SinkUnitEnum ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:DemandTechParameter ;
    skos:definition "Scaling mode for the sink demand profile: absolute, per unit area, or per unit flow capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:SinkUseEquals a owl:Class ;
    rdfs:label "SinkUseEquals" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:DemandTechParameter ;
    skos:definition "Fixed profile for the carrier flow removed from the system by the demand technology." ;
    skos:inScheme ontocal:parameters .

ontocal:SinkUseMax a owl:Class ;
    rdfs:label "SinkUseMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:DemandTechParameter ;
    skos:definition "Upper bound on the carrier flow that can be removed from the system by the demand technology." ;
    skos:inScheme ontocal:parameters .

ontocal:SinkUseMin a owl:Class ;
    rdfs:label "SinkUseMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:DemandTechParameter ;
    skos:definition "Lower bound on the carrier flow that must be removed from the system by the demand technology." ;
    skos:inScheme ontocal:parameters .

ontocal:SoftwareFramework a owl:Class ;
    rdfs:label "SoftwareFramework" ;
    skos:definition "OEO class for software frameworks." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00000382> ;
