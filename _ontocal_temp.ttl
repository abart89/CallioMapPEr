            owl:onProperty ontocal:value ],
        ontocal:SupplyTechParameter ;
    skos:definition "Scaling mode for the external resource flow: absolute, per unit area, or per unit flow capacity." ;
    skos:inScheme ontocal:parameters .

ontocal:SourceUse a owl:Class ;
