        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Fractional minimum state of charge that must be held in reserve at all times (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:StorageInitial a owl:Class ;
    rdfs:label "StorageInitial" ;
    rdfs:subClassOf [ a owl:Restriction ;
