ontocal:StorageCap a owl:Class ;
    rdfs:label "StorageCap" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
