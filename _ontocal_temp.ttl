            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:StorageTechVariable ;
    skos:definition "Virtual carrier stored between clustered representative days. Indexed by datestep, not regular timestep." ;
    skos:inScheme ontocal:variables .

ontocal:StorageIntraClusterMax a owl:Class ;
    rdfs:label "StorageIntraClusterMax" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:StorageTechVariable ;
    skos:definition "Virtual upper bound on stored carrier within a representative day. Indexed by cluster." ;
    skos:inScheme ontocal:variables .

ontocal:StorageIntraClusterMin a owl:Class ;
    rdfs:label "StorageIntraClusterMin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechVariable ;
    skos:definition "Virtual lower bound on stored carrier within a representative day. Indexed by cluster." ;
    skos:inScheme ontocal:variables .

ontocal:StorageLevel a owl:Class ;
    rdfs:label "StorageLevel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:at_node ],
        ontocal:StorageTechVariable ;
    skos:definition "Instantaneous quantity of stored carrier held in a storage technology at each timestep. (Calliope variable: storage)" ;
    skos:inScheme ontocal:variables .

ontocal:StorageLoss a owl:Class ;
    rdfs:label "StorageLoss" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        ontocal:StorageTechParameter ;
    skos:definition "Hourly decay rate representing energy lost from the reservoir over time." ;
    skos:inScheme ontocal:parameters .

ontocal:SystemwideCapacityFactor a owl:Class ;
    rdfs:label "SystemwideCapacityFactor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Average capacity factor for a technology aggregated across all spatial nodes and weighted timesteps. No at_node: system-wide aggregate." ;
    skos:inScheme ontocal:variables .

ontocal:SystemwideLevelisedCost a owl:Class ;
    rdfs:label "SystemwideLevelisedCost" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:TechVariable ;
    skos:definition "Production cost of a specific carrier per technology across the whole system (LCOE/LCOX per tech)." ;
    skos:inScheme ontocal:variables .

ontocal:TimeStep a owl:Class ;
    rdfs:label "TimeStep" ;
    rdfs:subClassOf ontocal:OneDimensionalTemporalRegion ;
    skos:definition "OEO class for a discrete timestep in a model simulation." ;
    skos:exactMatch <http://openenergy-platform.org/ontology/oeo/OEO_00030033> ;
    skos:inScheme <https://w3id.org/ontocal> .

ontocal:TotalLevelisedCost a owl:Class ;
    rdfs:label "TotalLevelisedCost" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        ontocal:SystemVariable ;
    skos:definition "Aggregate levelised cost to produce a specific carrier for the entire system." ;
    skos:inScheme ontocal:variables .

ontocal:UnmetDemand a owl:Class ;
    rdfs:label "UnmetDemand" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:for_carrier ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:for_carrier ],
        ontocal:NodeVariable ;
    skos:definition "Load shedding: virtual source of carrier flow added to ensure model feasibility per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:UnmetSum a owl:Class ;
    rdfs:label "UnmetSum" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:SystemVariable ;
    skos:definition "System-wide aggregate combining unmet demand and unused supply into a single feasibility/penalty metric." ;
    skos:inScheme ontocal:variables .

ontocal:UnusedSupply a owl:Class ;
    rdfs:label "UnusedSupply" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
