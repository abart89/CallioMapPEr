            owl:onProperty ontocal:unit ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        ontocal:SupplyTechParameter ;
    skos:definition "Base conversion efficiency capturing losses from the external environment into the technology (0 to 1)." ;
    skos:inScheme ontocal:parameters .

ontocal:SourceUnit a owl:Class ;
    rdfs:label "SourceUnit" ;
    rdfs:subClassOf [ a owl:Restriction ;
