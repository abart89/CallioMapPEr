            owl:onProperty ontocal:applies_to_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty ontocal:at_node ],
        ontocal:SupplyTechVariable ;
    skos:definition "Carrier flow consumed from outside system boundaries by a supply technology per timestep." ;
    skos:inScheme ontocal:variables .

ontocal:SourceUseEquals a owl:Class ;
    rdfs:label "SourceUseEquals" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ontocal:value ],
        [ a owl:Restriction ;
