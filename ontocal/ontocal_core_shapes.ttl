    sh:targetClass ontocal:ConversionTechParameter .

ontocal:ConversionTechVariable a sh:NodeShape ;
    rdfs:comment "A model variable scoped to a conversion technology." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
