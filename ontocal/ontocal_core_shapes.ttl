bfo:0000038 a sh:NodeShape ;
    rdfs:comment "A one-dimensional temporal region representing the maximal dataset boundaries defined at the base Calliope model level.",
        "A one-dimensional temporal region representing the specific sliced subset simulated by a Calliope scenario.",
        "BFO stub: a one-dimensional temporal region. Parent of all temporal classes in this schema." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ),
        ( bfo:0000139 rdf:type ) ;
    sh:property [ sh:class bfo:0000038 ;
            sh:description "A mereological relation linking a temporal proper part to its temporal whole." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path bfo:0000139 ] ;
    sh:targetClass bfo:0000038 .


